# --- Server ---
PORT=3000
NODE_ENV=development

# --- Postgres ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orders

# --- Redis (used for cache, rate limiting, idempotency locks, and BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Rate limiting (token bucket) ---
RATE_LIMIT_CAPACITY=20        # max burst tokens per client
RATE_LIMIT_REFILL_RATE=5      # tokens refilled per second
RATE_LIMIT_WINDOW_SECONDS=60

# --- Idempotency ---
IDEMPOTENCY_TTL_SECONDS=86400 # how long a completed response is cached (24h)
IDEMPOTENCY_LOCK_TTL_SECONDS=30 # in-flight lock duration for concurrent duplicate requests

# --- Cache ---
ORDER_CACHE_TTL_SECONDS=30

# --- Queue / retries ---
ORDER_QUEUE_NAME=process-order
NOTIFICATION_QUEUE_NAME=send-confirmation
DEAD_LETTER_QUEUE_NAME=order-dead-letter
MAX_JOB_ATTEMPTS=5
BACKOFF_BASE_MS=1000
